{
  "version": 1,
  "service": "example-auth",
  "routes": [
    {
      "method": null,
      "path": "/auth/",
      "requiresAuth": false
    },
    {
      "method": "GET",
      "path": "/billing",
      "requiresAuth": true
    },
    {
      "method": "GET",
      "path": "/health",
      "requiresAuth": false
    },
    {
      "method": "GET",
      "path": "/orgs/{id}/usage",
      "requiresAuth": true,
      "scope": "usage:read"
    },
    {
      "method": "GET",
      "path": "/v1/me",
      "requiresAuth": true
    },
    {
      "method": "POST",
      "path": "/v1/usage/record",
      "requiresAuth": true
    }
  ]
}
